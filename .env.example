# Optional Strapi CMS (no trailing slash). Leave empty to use the built-in content in /content,
# which is what the Vercel deployment does.
STRAPI_URL=

# Optional: Strapi API token. Needed only if public API access is removed in Strapi.
STRAPI_API_TOKEN=

# Shared secret for the /api/revalidate webhook (Strapi > Settings > Webhooks). Only used with Strapi.
REVALIDATE_SECRET=change-me

# Public URL of this site, used for metadata (Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
